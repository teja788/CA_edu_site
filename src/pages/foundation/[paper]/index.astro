---
import Base from '../../../layouts/Base.astro';
import Breadcrumb from '../../../components/Breadcrumb.astro';
import Badge from '../../../components/Badge.astro';
import AdSlot from '../../../components/AdSlot.astro';
import Mastery from '../../../components/Mastery.astro';
import TrustRow from '../../../components/TrustRow.astro';
import Callout from '../../../components/Callout.astro';
import PassRule from '../../../components/PassRule.astro';
import { attempt } from '../../../data/site.js';
import {
  foundationPapers,
  foundationScoring,
  formatWeightage,
  getWeightageGroupForChapter,
  getFreeLectureSources,
  p3SafePathTo40,
  WEIGHTAGE_NOTE,
  WEIGHTAGE_SOURCE,
} from '../../../data/foundation.js';

export function getStaticPaths() {
  return foundationPapers.map((paper) => ({
    params: { paper: paper.slug },
    props: { paper },
  }));
}

const { paper } = Astro.props;
const negative = paper.pattern.negativeMarking;
const practiceHref = `/practice/quiz/?level=foundation&paper=${paper.slug}${negative ? '&scoring=foundation' : ''}`;
const chapterCount = paper.sections.reduce((n, s) => n + s.chapters.length, 0);

// Weightage annotation only — the chapter order below is ICAI's and is never
// re-sorted by weightage. Groups are listed in syllabus order.
const weightageGroups = paper.weightageGroups ?? [];

// Paper 3 only: the safe-40 route. Chapter names come from the paper's own
// section lists so the links can never point at a slug that doesn't exist.
const chapterName = (slug) => {
  for (const s of paper.sections) {
    const ch = s.chapters.find((c) => c.slug === slug);
    if (ch) return ch.name;
  }
  return slug;
};
const safePath = paper.slug === 'quantitative-aptitude' ? p3SafePathTo40 : null;

// Free lecture companions — names and channel homepages only, never a
// specific video (see `freeLectureSources` for why, and for which URLs are
// verified). Notes + practice here are the other half of the work.
const lectures = getFreeLectureSources(paper.slug);
---

<Base title={`Paper ${paper.number}: ${paper.name} — CA Foundation`} active="papers">
  <main class="page">
    <Breadcrumb crumbs={[
      { label: 'CA Foundation', href: '/foundation/' },
      { label: `Paper ${paper.number} · ${paper.shortName}` },
    ]} />

    <div class="overline" style="margin-bottom: 6px;">CA Foundation · Paper {paper.number} of 4 · {paper.marks} marks</div>
    <h1 style="margin: 0; font-size: 30px; font-weight: 700; letter-spacing: -0.01em; line-height: 1.25;">
      Paper {paper.number}: {paper.name}
    </h1>
    <div style="margin-top: 12px;">
      <TrustRow attempt={attempt.name} updated="3 Jul 2026" source="ICAI SM index (May 2026 onwards ed.)" />
    </div>

    <div style="display: flex; flex-wrap: wrap; gap: 8px; margin-top: 16px;">
      <Badge kind="neutral">{paper.pattern.style}</Badge>
      {negative
        ? <Badge kind="amended">0.25 negative marking</Badge>
        : <Badge kind="neutral">No negative marking</Badge>}
      <Badge kind="neutral">{chapterCount} chapters</Badge>
    </div>

    <div class="tabs" role="tablist">
      <span class="active">Chapters</span>
      <a href={practiceHref}>Practice</a>
      <a href="#resources">Resources</a>
    </div>

    <!-- Pattern & passing rules -->
    <div class="overline" style="margin: 24px 0 12px;">Pattern &amp; passing rules</div>
    <div class="card card-pad" style="max-width: 720px;">
      <ul style="margin: 0; padding-left: 20px; font-size: 15px; line-height: 1.8; color: var(--text);">
        <li>{paper.marks} marks · {paper.pattern.style}{negative ? ' · every question carries negative marking' : ''}.</li>
        <li>Pass this paper: <strong>minimum 40 of 100</strong>.</li>
        <li><PassRule variant="plain" /></li>
        {negative ? (
          <li>
            Marking: <strong>+1 for a correct answer, −0.25 for a wrong answer, 0 for a skip</strong>.
            Guessing blind averages out to roughly zero — it only becomes clearly profitable once you can
            eliminate two options. The practice engine shows you this after every set.
          </li>
        ) : (
          <li>Descriptive paper — presentation earns marks: working notes, formats and stated assumptions.</li>
        )}
      </ul>
      <div class="trust-row" style="margin-top: 14px;">
        <Badge kind="verified">Verified for {attempt.name} attempt</Badge>
        <span>Always re-verify against the latest ICAI notification before your exam.</span>
      </div>
    </div>

    <!--
      Official ICAI section-wise weightage (announced 26 Oct 2023, ±5%
      deviation permitted) — source resource.cdn.icai.org/76829bos61899-foundation.pdf.
      Displayed in syllabus order; nothing below is sorted by weightage.
    -->
    {weightageGroups.length > 0 && (
      <>
        <div class="overline" style="margin: 32px 0 12px;">Official weightage</div>
        <div class="list-card" style="max-width: 720px;">
          {weightageGroups.map((g) => (
            <div class="list-row">
              <span style="flex: 1;">
                <span style="display: block; font-size: 15px; font-weight: 600;">{g.label}</span>
                {g.section && <span style="font-size: 13px; color: var(--text-3);">{g.section}</span>}
                {g.note && <span style="display: block; font-size: 13px; color: var(--text-3);">{g.note}</span>}
              </span>
              <span class="row-meta tnum" style="font-weight: 650; color: var(--text);">
                {g.weightage ? formatWeightage(g.weightage) : `${g.marks} marks`}
              </span>
            </div>
          ))}
        </div>
        <p style="font-size: 13px; color: var(--text-3); line-height: 1.6; max-width: 720px; margin: 10px 0 0;">
          {WEIGHTAGE_NOTE}{paper.weightageBasisLabel ? ` — each range is a share ${paper.weightageBasisLabel}` : ''}.
          Source: <a href={WEIGHTAGE_SOURCE.url} rel="noopener">{WEIGHTAGE_SOURCE.label} ↗</a> ·
          last checked {WEIGHTAGE_SOURCE.lastChecked}.
        </p>
      </>
    )}

    <!-- Paper 3 only: the safe route to the 40-mark bar. -->
    {safePath && (
      <div style="max-width: 720px; margin-top: 20px;">
        <Callout kind="pointer" label="A safe path to 40 in this paper">
          <p>
            Forty marks passes this paper. If Quantitative Aptitude is your weakest paper, three blocks
            carry most of that forty between them — secure these first, then spend whatever time is left
            widening out.
          </p>
          <ul style="margin: 0; padding-left: 20px; line-height: 1.8;">
            {safePath.map((item) => (
              <li>
                <strong>{item.label}</strong> — {item.detail}<br />
                {item.chapterSlugs.map((slug, si) => (
                  <>
                    {si > 0 && <span style="color: var(--text-3);"> · </span>}
                    <a href={`/foundation/${paper.slug}/${slug}/`}>{chapterName(slug)}</a>
                  </>
                ))}
              </li>
            ))}
          </ul>
          <p style="margin-top: 12px;">
            The mark figures are ICAI's official weightage; the order of attack is our reading of it, not
            an ICAI recommendation. Nothing here says skip the rest — it says what to cover first when
            time is short.
          </p>
        </Callout>
      </div>
    )}

    <!-- Chapters with mastery states -->
    {paper.sections.map((section, i) => (
      <>
        <div class="overline" style="margin: 24px 0 12px;">{section.name}</div>
        <div class="list-card">
          {section.chapters.map((ch) => {
            // Weightage of the ICAI group this chapter sits in — annotation only.
            const g = getWeightageGroupForChapter(paper.slug, ch.slug);
            const range = g && g.weightage ? formatWeightage(g.weightage) : null;
            return ch.hasNotes ? (
              <a class="list-row" href={`/foundation/${paper.slug}/${ch.slug}/`}>
                <span class="row-num tnum">{String(ch.number).padStart(2, '0')}</span>
                <span class="row-title">
                  {ch.name}
                  <span class="badge badge-draft" style="margin-left: 8px;">✎ Community draft</span>
                </span>
                {range && <span class="row-meta tnum" title={g.label}>{range}</span>}
                <Mastery level={0} topicId={`${paper.id}-ch${ch.number}`} />
                <span class="chev" aria-hidden="true">›</span>
              </a>
            ) : (
              <div class="list-row">
                <span class="row-num tnum">{String(ch.number).padStart(2, '0')}</span>
                <span class="row-title">{ch.name}</span>
                {range && <span class="row-meta tnum" title={g.label}>{range}</span>}
                <Mastery level={0} topicId={`${paper.id}-ch${ch.number}`} />
              </div>
            );
          })}
        </div>
        {i === 0 && <AdSlot />}
      </>
    ))}

    <div class="empty-state" style="max-width: 720px; margin-top: 20px;">
      <div style="font-size: 15px; font-weight: 650; margin-bottom: 4px;">Original notes and practice ship chapter by chapter</div>
      <div style="font-size: 14px; color: var(--text-2); line-height: 1.55;">
        Until a chapter goes live here, the official ICAI study material below is the complete,
        free syllabus source for this paper — start there today.
      </div>
    </div>

    <!--
      Lecture companions. Channel homepages only — a specific video URL rots
      within an attempt or two, a channel does not. Nothing here is affiliated
      with or endorsed by these teachers, and nothing is re-hosted.
    -->
    {lectures.length > 0 && (
      <div style="max-width: 720px; margin-top: 28px;">
        <div class="overline" style="margin-bottom: 10px;">Free lectures that pair well with these notes</div>
        <div class="card card-pad">
          <p style="font-size: 15px; line-height: 1.7; margin: 0;">
            {lectures.map((l, i) => (
              <>
                {i > 0 && <span style="color: var(--text-3);"> · </span>}
                <a href={l.url} rel="noopener" target="_blank">{l.name} ↗</a>
                <span style="font-size: 13px; color: var(--text-3);"> — {l.by}</span>
              </>
            ))}
          </p>
          <p style="font-size: 13px; color: var(--text-3); line-height: 1.6; margin: 12px 0 0;">
            Lectures are the explaining half of studying; the notes and practice here are the
            drill half. Watching more videos is the easiest way to feel prepared without
            becoming prepared — after a lecture, come back and answer questions on it from
            memory. We link channel homepages rather than individual videos, because playlists
            get reordered and single videos disappear. Independent teachers listed here are not
            affiliated with Adhyayan or with ICAI.
          </p>
        </div>
      </div>
    )}

    <!-- Official resources: deep links only, never re-hosted -->
    <div class="overline" id="resources" style="margin: 32px 0 12px;">Official ICAI resources · {attempt.name} attempt</div>
    <div class="list-card">
      {paper.resources.map((r) => (
        <a class="list-row" href={r.url} rel="noopener" target="_blank">
          <span style="flex: 1;">
            <span style="font-size: 15px; font-weight: 600; color: var(--info-text);">{r.title} ↗</span>
            <span style="display: block; font-size: 13px; color: var(--text-3); margin-top: 2px;">{r.host} · Last checked {r.lastChecked}</span>
          </span>
          {r.requiresLogin && <Badge kind="login">Requires ICAI login</Badge>}
        </a>
      ))}
    </div>
    <p style="font-size: 13px; color: var(--text-3); line-height: 1.6; max-width: 640px;">
      Links go to official sources only — nothing is re-hosted here. “Requires ICAI login” means the free
      student login on the BoS portal (registration number + date of birth). Foundation students see
      Foundation content after logging in.
    </p>
  </main>

</Base>
