---
import Base from '../../layouts/Base.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import Badge from '../../components/Badge.astro';
import { foundationPapers } from '../../data/foundation.js';

const questionCounts = { accounting: 503, 'business-laws': 386, 'quantitative-aptitude': 985, 'business-economics': 500 };
---

<Base title="Practice" active="practice">
  <main class="page">
    <Breadcrumb crumbs={[{ label: 'Home', href: '/' }, { label: 'Practice' }]} />

    <h1 style="margin: 0 0 6px; font-size: 30px; font-weight: 700; letter-spacing: -0.01em; line-height: 1.25;">Practice</h1>
    <p style="max-width: 640px; font-size: 17px; line-height: 1.7; color: var(--text-2); margin: 0 0 24px;">
      Original MCQs — every option explains why it's right or wrong.
      Wrong answers are saved to your Mistake notebook and come back later.
    </p>

    <!-- Paper-wise chapter practice -->
    <div class="overline" style="margin-bottom: 10px;">Practice by paper</div>
    <div class="list-card" style="max-width: 720px;">
      {foundationPapers.map((p) => {
        const qCount = questionCounts[p.slug] ?? 0;
        const negative = p.pattern.negativeMarking;
        const href = `/practice/quiz/?level=foundation&paper=${p.slug}${negative ? '&scoring=foundation' : ''}`;
        return (
          <a class="list-row" href={href}>
            <span style="flex: 1;">
              <span style="display: block; font-size: 16px; font-weight: 600;">Paper {p.number} · {p.name}</span>
              <span style="font-size: 13px; color: var(--text-2);">{qCount} questions · pick a chapter or practise all</span>
            </span>
            {negative && <Badge kind="amended">−0.25</Badge>}
            <span class="chev" aria-hidden="true">›</span>
          </a>
        );
      })}
    </div>

    <!-- Mixed and special modes -->
    <div class="overline" style="margin: 28px 0 10px;">Mixed &amp; exam-style</div>
    <div class="list-card" style="max-width: 720px;">
      <a class="list-row" href="/practice/foundation-mock/">
        <span style="flex: 1;">
          <span style="display: block; font-size: 16px; font-weight: 600;">Mock exam — full paper, to the clock</span>
          <span style="font-size: 13px; color: var(--text-2);">Papers 1–4 in the real shape: reading time, OMR for P3/P4, choose-4 for P1/P2, negative marking</span>
        </span>
        <span class="chev" aria-hidden="true">›</span>
      </a>
      <a class="list-row" href="/practice/quiz/?level=foundation&paper=quantitative-aptitude&mode=mixed&scoring=foundation">
        <span style="flex: 1;">
          <span style="display: block; font-size: 16px; font-weight: 600;">P3 · Mixed set — Maths, Reasoning &amp; Statistics together</span>
          <span style="font-size: 13px; color: var(--text-2);">20 questions from across chapters you've started, weighted to what you've got wrong</span>
        </span>
        <span class="chev" aria-hidden="true">›</span>
      </a>
      <a class="list-row" href="/practice/quiz/?level=foundation&paper=business-economics&mode=mixed&scoring=foundation">
        <span style="flex: 1;">
          <span style="display: block; font-size: 16px; font-weight: 600;">P4 · Mixed set — micro, macro &amp; Indian economy interleaved</span>
          <span style="font-size: 13px; color: var(--text-2);">20 questions across the Economics chapters you've started</span>
        </span>
        <span class="chev" aria-hidden="true">›</span>
      </a>
      <a class="list-row" href="/practice/quiz/?level=foundation&paper=business-laws&mode=confusable">
        <span style="flex: 1;">
          <span style="display: block; font-size: 16px; font-weight: 600;">P2 · Confusable regimes — 5 Acts shuffled together</span>
          <span style="font-size: 13px; color: var(--text-2);">Contract, Sale of Goods, Partnership, LLP, Companies Act — the exam makes you choose which applies</span>
        </span>
        <span class="chev" aria-hidden="true">›</span>
      </a>
    </div>

    <!-- Your progress -->
    <div class="overline" style="margin: 28px 0 10px;">Your progress</div>
    <div class="list-card" style="max-width: 720px;">
      <a class="list-row" href="/practice/quiz/?mode=mistakes">
        <span style="flex: 1;">
          <span style="display: block; font-size: 16px; font-weight: 600;">Mistake notebook</span>
          <span style="font-size: 13px; color: var(--text-2);" data-mistake-count>Questions you got wrong, back for another look</span>
        </span>
        <span class="chev" aria-hidden="true">›</span>
      </a>
      <a class="list-row" href="/dashboard/">
        <span style="flex: 1;">
          <span style="display: block; font-size: 16px; font-weight: 600;">Dashboard — see all your progress</span>
          <span style="font-size: 13px; color: var(--text-2);">Paper-wise progress, review queue, today's plan</span>
        </span>
        <span class="chev" aria-hidden="true">›</span>
      </a>
    </div>
  </main>

  <script>
    import { getMistakes } from '../../scripts/store.js';
    const n = getMistakes().length;
    const el = document.querySelector('[data-mistake-count]');
    if (el && n > 0) el.textContent = `${n} question${n === 1 ? '' : 's'} waiting for another look`;
  </script>
</Base>
