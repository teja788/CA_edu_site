---
import Base from '../layouts/Base.astro';
import AdSlot from '../components/AdSlot.astro';
import { attempt, papers, partnershipRefresherTopics } from '../data/site.js';
import { foundationAttempts, foundationPapers } from '../data/foundation.js';

// Progress denominator for P1: 15 syllabus chapters + the partnership
// refresher topics (same tracked-topic set the paper hub uses).
const p1TrackedTopics = papers.find((p) => p.id === 'p1').chapters + partnershipRefresherTopics.length;

// Slim attempt list for the picker — the client only needs the date, the
// registration cut-off and the label, not the whole exam-facts record.
const attemptOptions = foundationAttempts.map((a) => ({
  id: a.id,
  name: a.name,
  examDate: a.examDates.begins ?? null,
  examLabel: a.examDates.label,
  cutoff: a.registration?.cutoff ?? null,
  cutoffLabel: a.registration?.label ?? null,
  cutoffRule: a.registration?.rule ?? null,
  // Per-paper dates drive the exam-week gap-day kit; TBA attempts send [].
  papers: (a.papers ?? []).filter((p) => p.date).map((p) => ({ paperSlug: p.paperSlug, date: p.date, label: p.label })),
  sessionLabel: a.session?.label ?? null,
}));

// Just enough of each Foundation paper for the gap-day kit to build links.
const gapPapers = foundationPapers.map((p) => ({
  id: p.id,
  slug: p.slug,
  number: p.number,
  name: p.name,
  shortName: p.shortName,
  chapters: p.sections.flatMap((s) => s.chapters.map((c) => ({ number: c.number, slug: c.slug, name: c.name }))),
}));
---

<Base title="Dashboard" active="dashboard">
  <main class="page">
    <!-- greeting + factual attempt line -->
    <div style="display: flex; justify-content: space-between; align-items: flex-end; gap: 24px; margin-bottom: 24px; flex-wrap: wrap;">
      <div>
        <h1 style="margin: 0; font-size: 26px; font-weight: 700; line-height: 1.3;" data-greeting>Welcome</h1>
        <div style="font-size: 15px; color: var(--text-2); margin-top: 4px;">Your review queue, mistakes and paper progress — stored in this browser only.</div>
      </div>
      <div class="tnum" style="text-align: right; font-size: 14px; color: var(--text-2);">
        <div>{attempt.name} attempt begins <strong style="color: var(--text);">{attempt.beginsLabel}</strong></div>
        <div style="color: var(--text-3);"><span data-days-left data-begins={attempt.beginsOn}></span><a href="/attempt/">attempt details</a></div>
      </div>
    </div>

    <div class="dash-grid">
      <!-- left column -->
      <div style="display: flex; flex-direction: column; gap: 24px; min-width: 0;">
        <!-- today, from the study plan (adh-plan) — one sentence, or a quiet
             link to /plan/ when there is no plan yet. In exam week this card
             becomes the gap-day kit for the next paper. -->
        <section class="card card-pad" data-today-card>
          <div style="display: flex; justify-content: space-between; align-items: baseline; gap: 12px; flex-wrap: wrap; margin-bottom: 8px;">
            <div style="font-size: 18px; font-weight: 700;" data-today-title>Today’s plan</div>
            <a href="/plan/" style="font-size: 13px; font-weight: 600; text-decoration: none;" data-today-planlink>your plan</a>
          </div>
          <div style="font-size: 15px; line-height: 1.7; color: var(--text);" data-today-line>
            <a href="/plan/">Make a study plan</a> and today's work will appear here.
          </div>

          <!-- gap-day kit: only ever shown inside the exam window -->
          <div data-gap-kit hidden style="margin-top: 14px;">
            <div style="font-size: 14px; color: var(--text-2); line-height: 1.7; margin-bottom: 12px;" data-gap-intro></div>
            <div style="font-size: 13px; color: var(--text-3); margin-bottom: 6px;">One-pager pass — chapters of this paper</div>
            <div style="display: flex; flex-wrap: wrap; gap: 4px 12px; font-size: 14px; line-height: 1.7; margin-bottom: 14px;" data-gap-chapters></div>
            <div style="display: flex; flex-wrap: wrap; gap: 10px;" data-gap-actions></div>
            <div style="font-size: 13px; color: var(--text-2); line-height: 1.65; margin-top: 14px;" data-gap-evening></div>
          </div>

          <div style="margin-top: 14px;" data-today-min-wrap hidden>
            <button type="button" class="btn btn-tertiary" data-today-min-toggle aria-expanded="false">Can't today — show the minimum</button>
            <div data-today-min hidden style="font-size: 14px; color: var(--text-2); line-height: 1.7; margin-top: 12px;"></div>
          </div>
        </section>

        <!-- review queue — never interrupted by ads -->
        <section class="card card-pad">
          <div style="display: flex; justify-content: space-between; align-items: baseline; margin-bottom: 4px; gap: 12px; flex-wrap: wrap;">
            <div style="font-size: 18px; font-weight: 700;">Today's review</div>
            <div style="font-size: 13px; color: var(--text-3);">Spaced repetition · <a href="/about/">how this works</a></div>
          </div>
          <div style="font-size: 14px; color: var(--text-2); margin-bottom: 16px;" data-queue-caption>
            Anything skipped simply waits.
          </div>
          <div style="display: flex; flex-direction: column;" data-queue>
            <div style="display: flex; align-items: center; gap: 14px; min-height: 52px; border-top: 1px solid var(--surface-2);">
              <span style="width: 22px; height: 22px; border-radius: 6px; background: var(--accent-tint); color: var(--accent); display: inline-flex; align-items: center; justify-content: center; font-size: 11px; flex-shrink: 0;" aria-hidden="true">✎</span>
              <span style="flex: 1; font-size: 15px; font-weight: 600;">Admission of a partner — practice set</span>
              <span style="font-size: 13px; color: var(--text-3);">P1 · Ch 4</span>
            </div>
            <div style="display: flex; align-items: center; gap: 14px; min-height: 52px; border-top: 1px solid var(--surface-2);">
              <span style="width: 22px; height: 22px; border-radius: 6px; background: var(--incorrect-tint); color: var(--incorrect-text); display: inline-flex; align-items: center; justify-content: center; font-size: 11px; flex-shrink: 0;" aria-hidden="true">✕</span>
              <span style="flex: 1; font-size: 15px; font-weight: 600;" data-queue-mistakes>From Mistake notebook</span>
              <span style="font-size: 13px; color: var(--text-3);">Mixed</span>
            </div>
            <div style="display: flex; align-items: center; gap: 14px; min-height: 52px; border-top: 1px solid var(--surface-2); border-bottom: 1px solid var(--surface-2);">
              <span style="width: 22px; height: 22px; border-radius: 6px; background: var(--info-tint); color: var(--info-text); display: inline-flex; align-items: center; justify-content: center; font-size: 11px; flex-shrink: 0;" aria-hidden="true">★</span>
              <span style="flex: 1; font-size: 15px; font-weight: 600;" data-queue-cards>Flashcards — quick recall</span>
              <span style="font-size: 13px; color: var(--text-3);">Spaced</span>
            </div>
          </div>
          <a href="/practice/quiz/" class="btn btn-primary" style="margin-top: 18px;" data-review-cta>Start today's review</a>
        </section>

        <!-- ad slot BELOW the queue card -->
        <AdSlot />

        <!-- recent mistakes -->
        <section class="card card-pad" id="mistakes">
          <div style="display: flex; justify-content: space-between; align-items: baseline; margin-bottom: 14px;">
            <div style="font-size: 18px; font-weight: 700;">Recent mistakes</div>
            <a href="/practice/quiz/?mode=mistakes" style="font-size: 14px; font-weight: 600; text-decoration: none;">Retry all →</a>
          </div>
          <div style="display: flex; flex-direction: column;" data-mistake-list>
            <div class="empty-state" style="border: none; padding: 20px 0;">
              <div style="font-size: 14px; color: var(--text-2);">No mistakes logged yet. They'll appear here after you practise.</div>
            </div>
          </div>
        </section>

        <!-- Confidence calibration — hidden until there are enough tagged
             answers for the comparison to mean anything. -->
        <section class="card card-pad" data-calibration hidden>
          <div style="font-size: 18px; font-weight: 700; margin-bottom: 4px;">Confidence check</div>
          <div style="font-size: 14px; color: var(--text-2); margin-bottom: 16px;">
            How your “Sure” and “Not sure” taps in practice compared with what actually happened.
          </div>
          <div style="display: flex; gap: 28px; flex-wrap: wrap;" class="tnum">
            <div>
              <div style="font-size: 13px; color: var(--text-3);">When you said Sure</div>
              <div style="font-size: 22px; font-weight: 700;" data-cal-sure-pct>—</div>
              <div style="font-size: 13px; color: var(--text-2);" data-cal-sure-n></div>
            </div>
            <div>
              <div style="font-size: 13px; color: var(--text-3);">When you said Not sure</div>
              <div style="font-size: 22px; font-weight: 700;" data-cal-unsure-pct>—</div>
              <div style="font-size: 13px; color: var(--text-2);" data-cal-unsure-n></div>
            </div>
          </div>
          <div style="font-size: 14px; color: var(--text-2); line-height: 1.6; margin-top: 16px;" data-cal-note></div>
        </section>
      </div>

      <!-- right rail -->
      <div style="display: flex; flex-direction: column; gap: 24px; min-width: 0;">
        <!-- attempt picker: the scheduler keeps every card inside this window -->
        <section class="card card-pad">
          <div style="font-size: 15px; font-weight: 700; margin-bottom: 6px;">Your attempt</div>
          <div style="font-size: 13px; color: var(--text-2); line-height: 1.55; margin-bottom: 12px;">
            Set it and the review schedule stays inside your exam window — nothing gets pushed past the paper. Change it whenever your plan changes.
          </div>
          <label for="attempt-select" style="font-size: 13px; color: var(--text-3); display: block; margin-bottom: 6px;">Foundation attempt</label>
          <select id="attempt-select" data-attempt-select style="width: 100%; min-height: 44px; font: inherit; font-size: 15px; color: var(--text); background: var(--surface); border: 1px solid var(--border); border-radius: 8px; padding: 8px 10px;">
            <option value="">Not set</option>
            {foundationAttempts.map((a) => (
              <option value={a.id} data-exam-date={a.examDates.begins ?? ''}>
                {a.name}{a.examDates.begins ? '' : ' — dates not notified'}
              </option>
            ))}
          </select>
          <div data-attempt-custom hidden style="margin-top: 12px;">
            <label for="attempt-date" style="font-size: 13px; color: var(--text-2); display: block; line-height: 1.55; margin-bottom: 6px;">
              ICAI has not notified these dates yet. If you are working to a date of your own, use it — it only shapes the spacing.
            </label>
            <input type="date" id="attempt-date" data-attempt-date style="width: 100%; min-height: 44px; font: inherit; font-size: 15px; color: var(--text); background: var(--surface); border: 1px solid var(--border); border-radius: 8px; padding: 8px 10px;" />
          </div>
          <div class="tnum" data-attempt-days style="font-size: 14px; color: var(--text-2); margin-top: 12px; line-height: 1.6;"></div>
          <div data-attempt-cutoff hidden style="font-size: 13px; color: var(--warning-text); background: var(--warning-tint); border: 1px solid var(--warning-border); border-radius: 8px; padding: 10px 12px; margin-top: 12px; line-height: 1.55;"></div>
        </section>

        <section class="card card-pad">
          <div style="font-size: 18px; font-weight: 700; margin-bottom: 16px;">Your papers</div>
          <div style="display: flex; flex-direction: column; gap: 18px;">
            {papers.filter((p) => p.group === 1).map((p) => (
              <div>
                <div style="display: flex; justify-content: space-between; font-size: 14px; margin-bottom: 6px;">
                  <span style={`font-weight: 600; ${p.status !== 'live' ? 'color: var(--text-3);' : ''}`}>P{p.number} · {p.shortName}</span>
                  {p.status === 'live'
                    ? <span class="tnum" style="color: var(--text-2);" data-paper-pct={p.id} data-total={p.id === 'p1' ? p1TrackedTopics : 0}>0%</span>
                    : <span style="font-size: 13px; color: var(--text-3);">Coming soon</span>}
                </div>
                <div class="progress-track">
                  {p.status === 'live' && <div class="progress-fill" style="width: 0%;" data-paper-fill={p.id}></div>}
                </div>
              </div>
            ))}
          </div>
          <a href="/intermediate/" style="display: inline-flex; align-items: center; min-height: 44px; font-size: 14px; font-weight: 600; text-decoration: none; margin-top: 10px;">All papers →</a>
        </section>

        <section class="card card-pad">
          <div style="font-size: 15px; font-weight: 700; margin-bottom: 8px;">This week</div>
          <div class="tnum" style="font-size: 14px; color: var(--text-2); line-height: 1.7;" data-week-stats>
            No sessions yet this week.
          </div>
          <div style="font-size: 13px; color: var(--text-3); margin-top: 10px; line-height: 1.55;">
            A quiet week is fine. The queue adjusts to you.
          </div>
          <div data-gap-note hidden style="font-size: 13px; color: var(--text-2); margin-top: 10px; line-height: 1.55;">
            Missing days doesn't reset anything. Pick up where you left off.
          </div>
        </section>

        <!-- backup: this browser is the only copy, so make a second one easy -->
        <section class="card card-pad">
          <div style="font-size: 15px; font-weight: 700; margin-bottom: 6px;">Backup</div>
          <div style="font-size: 13px; color: var(--text-2); line-height: 1.55; margin-bottom: 12px;">
            Your progress lives in this browser only. A backup file moves it to another device, or brings it back after a cleared cache.
          </div>
          <div style="display: flex; flex-wrap: wrap; gap: 10px;">
            <button type="button" class="btn btn-secondary" data-backup-download>Download backup</button>
            <button type="button" class="btn btn-tertiary" data-backup-restore>Restore backup</button>
          </div>
          <input type="file" accept="application/json,.json" data-backup-file hidden />
          <div style="font-size: 13px; color: var(--text-3); margin-top: 10px; line-height: 1.55;">
            Restoring adds to what is already here — mastery keeps the higher level, and nothing in this browser is deleted.
          </div>
          <div data-backup-status style="font-size: 13px; color: var(--text-2); margin-top: 8px; line-height: 1.55;"></div>
        </section>
      </div>
    </div>
  </main>

  <style>
    .dash-grid {
      display: grid;
      grid-template-columns: 1.5fr 1fr;
      gap: 24px;
      align-items: start;
    }
    @media (max-width: 800px) {
      .dash-grid { grid-template-columns: 1fr; }
    }
  </style>

  <script type="application/json" data-attempts set:html={JSON.stringify(attemptOptions)}></script>
  <script type="application/json" data-gap-papers set:html={JSON.stringify(gapPapers)}></script>

  <script>
    import {
      getMistakes,
      getDueMistakes,
      getWeekStats,
      getPaperProgress,
      getDueCards,
      getAttempt,
      setAttempt,
      getDaysToExam,
      getCalibration,
      getLastActivity,
      exportProgress,
      importProgress,
    } from '../scripts/store.js';
    import { allCards } from '../data/flashcards.js';
    import { humanDate, addDays, diffDays, dayFor, MINIMUM_DOSE } from '../scripts/planner.js';

    // Greeting by time of day — factual, no pressure.
    const h = new Date().getHours();
    document.querySelector('[data-greeting]').textContent =
      h < 12 ? 'Good morning' : h < 17 ? 'Good afternoon' : 'Good evening';

    // Factual countdown — the date rides on the element from site.js, so a
    // new attempt pointer never leaves a stale hardcoded date here.
    const daysEl = document.querySelector('[data-days-left]');
    const begins = new Date(`${daysEl.dataset.begins}T00:00:00+05:30`);
    const days = Math.max(0, Math.ceil((begins.getTime() - Date.now()) / 86400000));
    daysEl.textContent = `${days} days from today · `;

    // Review queue caption + rows.
    const mistakes = getMistakes();
    const dueMistakes = getDueMistakes();
    const due = getDueCards(allCards).length;
    const items = 1 + dueMistakes.length + due;
    const minutes = Math.max(5, Math.round(items * 1.5));
    document.querySelector('[data-queue-caption]').textContent =
      `${items} item${items === 1 ? '' : 's'} due — about ${minutes} minutes. Anything skipped simply waits.`;
    document.querySelector('[data-queue-mistakes]').textContent = dueMistakes.length > 0
      ? `From Mistake notebook — ${dueMistakes.length} ready to retry`
      : mistakes.length > 0
        ? `Mistake notebook — ${mistakes.length} logged, none due yet`
        : 'Mistake notebook — empty, nothing waiting';
    document.querySelector('[data-queue-cards]').textContent = due > 0
      ? `Flashcards — ${due} card${due === 1 ? '' : 's'} due`
      : 'Flashcards — all scheduled ahead';
    // Cards due? Review starts there; otherwise the practice set.
    if (due > 0) document.querySelector('[data-review-cta]').href = '/practice/flashcards/';

    // Recent mistakes list.
    if (mistakes.length > 0) {
      const wrap = document.querySelector('[data-mistake-list]');
      wrap.innerHTML = '';
      mistakes.slice(0, 5).forEach((m, i) => {
        const row = document.createElement('div');
        row.style.cssText = `display: flex; align-items: center; gap: 14px; min-height: 52px; border-top: 1px solid var(--surface-2); ${i === Math.min(mistakes.length, 5) - 1 ? 'border-bottom: 1px solid var(--surface-2);' : ''}`;
        const topic = document.createElement('span');
        topic.style.cssText = 'flex: 1; font-size: 15px;';
        // textContent: topics round-trip through localStorage — never innerHTML.
        topic.textContent = m.topic;
        const retry = document.createElement('a');
        retry.href = '/practice/quiz/?mode=mistakes';
        retry.style.cssText = 'font-size: 14px; font-weight: 600; text-decoration: none; min-height: 44px; display: flex; align-items: center;';
        retry.textContent = 'Retry';
        row.append(topic, retry);
        wrap.appendChild(row);
      });
    }

    // This week facts.
    const stats = getWeekStats();
    if (stats.attempted > 0) {
      document.querySelector('[data-week-stats]').textContent =
        `${stats.attempted} questions attempted · ${stats.correct} correct`;
    }

    // Quiet nudge after a break — never a streak, never a scold.
    const last = getLastActivity();
    if (last && Date.now() - last >= 4 * 86400000) {
      document.querySelector('[data-gap-note]').hidden = false;
    }

    /* ── Attempt picker ───────────────────────────────────────────────── */
    const attempts = JSON.parse(document.querySelector('[data-attempts]').textContent);
    const attemptSelect = document.querySelector('[data-attempt-select]');
    const customWrap = document.querySelector('[data-attempt-custom]');
    const dateInput = document.querySelector('[data-attempt-date]');
    const daysLine = document.querySelector('[data-attempt-days]');
    const cutoffBox = document.querySelector('[data-attempt-cutoff]');

    function renderAttempt() {
      const saved = getAttempt();
      attemptSelect.value = saved?.id ?? '';
      const meta = attempts.find((a) => a.id === attemptSelect.value) ?? null;
      // Attempts ICAI has not notified take a date the student supplies.
      customWrap.hidden = !(meta && !meta.examDate);
      if (meta && !meta.examDate && saved?.examDate) dateInput.value = saved.examDate;

      if (!saved) {
        daysLine.textContent = 'No attempt set — reviews use ordinary spacing.';
      } else {
        const days = getDaysToExam();
        const name = meta?.name ?? saved.id;
        daysLine.textContent =
          days === null
            ? `${name} — ICAI has not notified the dates. Add one above if you want the spacing to tighten toward it.`
            : days > 0
              ? `${days} day${days === 1 ? '' : 's'} to ${name}. Reviews are kept inside that window.`
              : `${name} has come and gone. Pick the next attempt when you're ready.`;
      }

      // Next registration cut-off still ahead — the selected attempt's own
      // cut-off first, otherwise the nearest one across attempts.
      const now = Date.now();
      const ahead = attempts
        .filter((a) => a.cutoff && new Date(`${a.cutoff}T00:00:00+05:30`).getTime() > now)
        .sort((a, b) => a.cutoff.localeCompare(b.cutoff));
      const relevant = ahead.find((a) => a.id === attemptSelect.value) ?? ahead[0] ?? null;
      if (relevant) {
        cutoffBox.hidden = false;
        cutoffBox.textContent = `Registration for ${relevant.name} closes ${relevant.cutoffLabel}. ${relevant.cutoffRule ?? ''}`.trim();
      } else {
        cutoffBox.hidden = true;
      }
    }

    attemptSelect.addEventListener('change', () => {
      const id = attemptSelect.value;
      if (!id) {
        setAttempt(null);
      } else {
        const meta = attempts.find((a) => a.id === id);
        setAttempt(id, meta?.examDate ?? (dateInput.value || null));
      }
      renderAttempt();
    });
    dateInput.addEventListener('change', () => {
      if (!attemptSelect.value) return;
      setAttempt(attemptSelect.value, dateInput.value || null);
      renderAttempt();
    });
    renderAttempt();

    /* ── Confidence calibration ───────────────────────────────────────── */
    const cal = getCalibration();
    // Below 20 tagged answers — or with nothing on one side — the two
    // accuracies are noise. Say nothing.
    if (cal.tagged >= 20 && cal.sure.n > 0 && cal.unsure.n > 0) {
      const panel = document.querySelector('[data-calibration]');
      panel.hidden = false;
      document.querySelector('[data-cal-sure-pct]').textContent = `${cal.sure.pct}%`;
      document.querySelector('[data-cal-sure-n]').textContent =
        `${cal.sure.correct} of ${cal.sure.n} correct`;
      document.querySelector('[data-cal-unsure-pct]').textContent = `${cal.unsure.pct}%`;
      document.querySelector('[data-cal-unsure-n]').textContent =
        `${cal.unsure.correct} of ${cal.unsure.n} correct`;
      document.querySelector('[data-cal-note]').textContent =
        cal.verdict === 'overconfident'
          ? 'Your “Sure” answers are not yet much safer than your guesses. The confident misses are the highest-value things to fix — they are in the notebook and come back first.'
          : cal.verdict === 'underconfident'
            ? 'You get most of the questions you doubt right as well. The knowledge is there; the hesitation is costing you time in the paper, not marks.'
            : 'Your sense of knowing is tracking reality — sure means right far more often than not sure. That signal is worth trusting when you decide what to attempt.';
    }

    /* ── Backup ───────────────────────────────────────────────────────── */
    const status = document.querySelector('[data-backup-status]');
    const fileInput = document.querySelector('[data-backup-file]');

    document.querySelector('[data-backup-download]').addEventListener('click', () => {
      try {
        const blob = new Blob([JSON.stringify(exportProgress(), null, 2)], { type: 'application/json' });
        const url = URL.createObjectURL(blob);
        const a = document.createElement('a');
        a.href = url;
        a.download = `adhyayan-backup-${new Date().toISOString().slice(0, 10)}.json`;
        document.body.appendChild(a);
        a.click();
        a.remove();
        setTimeout(() => URL.revokeObjectURL(url), 2000);
        status.textContent = 'Backup saved to your downloads.';
      } catch {
        status.textContent = 'This browser blocked the download. Nothing changed.';
      }
    });

    document.querySelector('[data-backup-restore]').addEventListener('click', () => fileInput.click());
    fileInput.addEventListener('change', () => {
      const file = fileInput.files?.[0];
      if (!file) return;
      const reader = new FileReader();
      reader.onload = () => {
        let merged = null;
        try {
          merged = importProgress(JSON.parse(String(reader.result)));
        } catch {
          merged = null;
        }
        if (!merged) {
          status.textContent = 'That file does not look like an Adhyayan backup. Nothing changed.';
          fileInput.value = '';
          return;
        }
        status.textContent = 'Restored. Reloading the page…';
        setTimeout(() => location.reload(), 500);
      };
      reader.onerror = () => {
        status.textContent = 'That file could not be read. Nothing changed.';
      };
      reader.readAsText(file);
    });

    // Paper progress — same key prefixes and denominator as the paper hub.
    const pct = document.querySelector('[data-paper-pct="p1"]');
    const fill = document.querySelector('[data-paper-fill="p1"]');
    if (pct) {
      const p1 = getPaperProgress(['i1-ch', 'p1-ch4-'], Number(pct.dataset.total));
      pct.textContent = `${p1.pct}%`;
      if (fill) fill.style.width = `${p1.pct}%`;
    }

    /* ── Today, from the study plan ───────────────────────────────────────
       Reads `adh-plan` (written by /plan/) — store.js is untouched. Inside
       the exam window this card becomes the gap-day kit instead. */
    const gapPapers = JSON.parse(document.querySelector('[data-gap-papers]').textContent);
    const paperBySlug = new Map(gapPapers.map((p) => [p.slug, p]));
    const paperByNumber = new Map(gapPapers.map((p) => [p.number, p]));
    const today = new Date().toLocaleDateString('en-CA', { timeZone: 'Asia/Kolkata' });

    const todayTitle = document.querySelector('[data-today-title]');
    const todayLine = document.querySelector('[data-today-line]');
    const gapKit = document.querySelector('[data-gap-kit]');
    const minWrap = document.querySelector('[data-today-min-wrap]');
    const minToggle = document.querySelector('[data-today-min-toggle]');
    const minBox = document.querySelector('[data-today-min]');

    let storedPlan = null;
    try {
      const raw = localStorage.getItem('adh-plan');
      storedPlan = raw ? JSON.parse(raw) : null;
    } catch {
      storedPlan = null; // unreadable plan is the same as no plan
    }
    const plan = storedPlan?.plan ?? null;

    function anchor(href, text) {
      const a = document.createElement('a');
      a.href = href;
      a.textContent = text;
      a.style.cssText = 'font-weight: 600; text-decoration: none;';
      return a;
    }

    /** Foundation question ids carry their paper: q-f1c4-001, cs-f2c2-01, d-f1c7-03. */
    function paperNumberOfQuestion(id) {
      const m = /(?:^|-)f(\d+)c\d+/.exec(id ?? '');
      return m ? Number(m[1]) : null;
    }

    /** The links that belong with one plan assignment. */
    function linksForAssignment(a) {
      if (a.activity === 'mock') return [['/practice/foundation-mock/', 'mock room']];
      if (a.activity === 'flashcards') return [['/practice/flashcards/', 'flashcards']];
      if (!a.paperSlug) return [['/practice/quiz/?mode=mistakes', 'mistakes']];
      if (a.chapterSlug) {
        return [
          [`/foundation/${a.paperSlug}/${a.chapterSlug}/`, 'open'],
          [`/practice/quiz/?level=foundation&paper=${a.paperSlug}&chapter=${a.chapterSlug}`, 'practise'],
        ];
      }
      return [[`/foundation/${a.paperSlug}/`, 'chapters'], [`/practice/quiz/?level=foundation&paper=${a.paperSlug}`, 'practise']];
    }

    /** One assignment, said the short way — the card is a sentence, not a table. */
    function shortPhrase(a) {
      const chapter = a.chapterName ?? null;
      if (a.activity === 'mock') return a.label;
      if (a.activity === 'flashcards') return 'your due flashcards';
      if (!chapter) return `${a.paperName ?? 'mixed'} one-pager`;
      if (a.activity === 'notes') return `${a.paperName} — ${chapter} notes`;
      if (a.activity === 'practice') return `${a.paperName} — ${chapter} questions`;
      if (a.activity === 'mixed') return `${a.paperName} — revise ${chapter}, then questions`;
      return `${a.paperName} — ${chapter}`;
    }

    function actionButton(href, text, cls) {
      const a = document.createElement('a');
      a.href = href;
      a.textContent = text;
      a.className = `btn ${cls}`;
      a.style.textDecoration = 'none';
      return a;
    }

    /* The minimum effective dose, one tap away on any ordinary day. */
    (function buildMinimum() {
      const line = document.createElement('div');
      line.appendChild(document.createTextNode('The minimum that still counts: '));
      line.appendChild(anchor('/practice/flashcards/', 'your due flashcards'));
      line.appendChild(document.createTextNode(', then '));
      line.appendChild(anchor('/practice/quiz/?mode=mixed', 'ten mixed questions'));
      line.appendChild(document.createTextNode(`. ${MINIMUM_DOSE.minutes[0].toUpperCase()}${MINIMUM_DOSE.minutes.slice(1)}, and the day counts.`));
      minBox.appendChild(line);
      const why = document.createElement('div');
      why.style.cssText = 'color: var(--text-3); margin-top: 8px;';
      why.textContent = MINIMUM_DOSE.why;
      minBox.appendChild(why);
    })();

    minToggle.addEventListener('click', () => {
      const show = minBox.hidden;
      minBox.hidden = !show;
      minToggle.setAttribute('aria-expanded', show ? 'true' : 'false');
      minToggle.textContent = show ? 'Hide the minimum' : 'Can’t today — show the minimum';
    });

    /* Exam window: the attempt's own notified paper dates first, the stored
       plan's copy second. First paper − 1 through the last paper. */
    const savedAttempt = getAttempt();
    const attemptMeta = attempts.find((a) => a.id === savedAttempt?.id) ?? null;
    let examPapers = (attemptMeta?.papers ?? []).slice();
    if (examPapers.length === 0 && Array.isArray(plan?.examWindow?.papers)) {
      examPapers = plan.examWindow.papers.slice();
    }
    examPapers.sort((a, b) => a.date.localeCompare(b.date));
    const inExamWindow = examPapers.length > 0
      && today >= addDays(examPapers[0].date, -1)
      && today <= examPapers[examPapers.length - 1].date;

    function renderGapDay() {
      const next = examPapers.find((p) => p.date >= today);
      const paper = next ? paperBySlug.get(next.paperSlug) : null;
      if (!paper) return false;
      const away = diffDays(today, next.date);

      todayTitle.textContent = 'Exam week';
      todayLine.textContent = away === 0
        ? `${paper.name} today — the paper begins at 2:00 PM.`
        : away === 1
          ? `${paper.name} tomorrow, ${humanDate(next.date)}. Today belongs to it.`
          : `Next paper: ${paper.name} on ${humanDate(next.date)}, ${away} days away.`;

      document.querySelector('[data-gap-intro]').textContent = away === 0
        ? 'Nothing new goes in today. One pass of your one-pagers, then the hall.'
        : 'Whatever is written is written — that paper cannot move now. This one still can, and it is the only thing today is for.';

      const chapterBox = document.querySelector('[data-gap-chapters]');
      chapterBox.innerHTML = '';
      for (const ch of paper.chapters) {
        chapterBox.appendChild(anchor(`/foundation/${paper.slug}/${ch.slug}/`, `${ch.number}. ${ch.name}`));
      }

      const mine = dueMistakes.filter((m) => paperNumberOfQuestion(m.questionId) === paper.number);
      const actions = document.querySelector('[data-gap-actions]');
      actions.innerHTML = '';
      if (mine.length > 0) {
        actions.appendChild(actionButton(
          `/practice/quiz/?mode=mistakes&level=foundation&paper=${paper.slug}`,
          `Retry ${mine.length} mistake${mine.length === 1 ? '' : 's'} from this paper`,
          'btn-primary'
        ));
      }
      actions.appendChild(actionButton(
        `/practice/quiz/?level=foundation&paper=${paper.slug}`,
        mine.length > 0 ? 'Practice questions' : 'Practice questions from this paper',
        mine.length > 0 ? 'btn-secondary' : 'btn-primary'
      ));

      document.querySelector('[data-gap-evening]').textContent =
        'Stop while there is still light in the sky. Eat something, and sleep — the sleep is what fixes today’s revision, and the last hour of the night has never shown up on an answer sheet.';

      gapKit.hidden = false;
      minWrap.hidden = true; // in exam week the one-pager pass IS the minimum
      return true;
    }

    function renderPlanDay() {
      if (!plan || !Array.isArray(plan.weeks) || plan.weeks.length === 0) return false;
      const day = dayFor(plan, today);

      if (!day) {
        const first = plan.weeks[0].days[0].date;
        todayLine.textContent = '';
        if (today < first) {
          todayLine.appendChild(document.createTextNode(`Your plan starts on ${humanDate(first)}. Until then the review queue below is plenty — `));
          todayLine.appendChild(anchor('/plan/', 'see the plan'));
        } else {
          todayLine.appendChild(document.createTextNode('This plan has run past its exam date. When you are ready for the next attempt, '));
          todayLine.appendChild(anchor('/plan/', 'build the next one'));
        }
        todayLine.appendChild(document.createTextNode('.'));
        minWrap.hidden = false;
        return true;
      }

      if (day.kind === 'buffer') {
        todayLine.textContent = 'Buffer day — catch up on anything that slipped, or rest. Both are the plan working.';
        minWrap.hidden = false;
        return true;
      }

      todayLine.textContent = '';
      todayLine.appendChild(document.createTextNode('Today: '));
      day.assignments.forEach((a, i) => {
        if (i > 0) {
          todayLine.appendChild(document.createTextNode(i === day.assignments.length - 1 ? ', then ' : ', '));
        }
        todayLine.appendChild(document.createTextNode(shortPhrase(a)));
        const links = document.createElement('span');
        links.style.fontSize = '13px';
        for (const [href, text] of linksForAssignment(a)) {
          links.appendChild(document.createTextNode(' · '));
          links.appendChild(anchor(href, text));
        }
        todayLine.appendChild(links);
      });
      if (day.assignments.length === 0) {
        todayLine.appendChild(document.createTextNode('nothing scheduled — the review queue below is the day.'));
      }
      if (day.note) {
        const note = document.createElement('div');
        note.style.cssText = 'font-size: 13px; color: var(--text-3); line-height: 1.65; margin-top: 8px;';
        note.textContent = day.note;
        todayLine.appendChild(note);
      }
      minWrap.hidden = false;
      return true;
    }

    if (!(inExamWindow && renderGapDay())) renderPlanDay();
  </script>
</Base>
